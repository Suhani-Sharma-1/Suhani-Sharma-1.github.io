<style>
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    scroll-behavior: smooth;
}

:root {
    --purple: #a78bfa;
    --dark: #11111f;
    --card: #171727;
    --muted: #c4c0d5;
}

body {
    font-family: 'Segoe UI', Arial, sans-serif;
    background: #0b0b14;
    color: #f5f3ff;
    line-height: 1.7;
}

header {
    background: #11111f;
    padding: 20px 8%;
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 15px;
    border-bottom: 1px solid #29243c;
}

.logo {
    color: var(--purple);
    font-size: 23px;
    font-weight: bold;
}

nav {
    display: flex;
    flex-wrap: wrap;
    gap: 18px;
}

nav a {
    color: white;
    text-decoration: none;
    font-weight: bold;
    font-size: 14px;
    transition: color 0.3s;
}

nav a:hover {
    color: var(--purple);
}

.hero {
    min-height: 520px;
    padding: 110px 20px;
    text-align: center;
    background:
        radial-gradient(circle at 50% 20%, #39235e, transparent 55%),
        linear-gradient(135deg, #10101e, #171127);
}

.hero .tag {
    color: var(--purple);
    letter-spacing: 3px;
    font-size: 13px;
}

.hero h1 {
    font-size: clamp(36px, 7vw, 58px);
    margin: 15px 0;
}

.hero h1 span {
    color: var(--purple);
}

.hero p {
    max-width: 650px;
    margin: auto;
    color: var(--muted);
    font-size: 18px;
}

.btn {
    display: inline-block;
    margin: 25px 8px 0;
    padding: 12px 25px;
    border-radius: 30px;
    background: var(--purple);
    color: #171127;
    font-weight: bold;
    text-decoration: none;
    transition: background 0.3s;
}

.btn:hover {
    background: white;
}

section {
    max-width: 1000px;
    margin: 35px auto;
    padding: 40px 30px;
    background: var(--card);
    border: 1px solid #29243c;
    border-radius: 15px;
}

.section-title {
    color: var(--purple);
    font-size: 28px;
    margin-bottom: 20px;
}

section p {
    color: var(--muted);
    margin-bottom: 12px;
}

.grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 18px;
}

.item {
    background: #211c32;
    border: 1px solid #382d50;
    padding: 22px;
    border-radius: 12px;
}

.item h3 {
    color: #d6c6ff;
    margin-bottom: 8px;
}

.skills {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
}

.skills span {
    background: #302347;
    color: #e9ddff;
    padding: 10px 18px;
    border-radius: 25px;
    font-size: 14px;
}

.contact a {
    color: var(--purple);
    text-decoration: none;
}

footer {
    background: #11111f;
    text-align: center;
    padding: 30px 15px;
    color: #aaa4bd;
    margin-top: 40px;
}

footer span {
    color: var(--purple);
}

@media(max-width: 600px) {
    header {
        justify-content: center;
    }

    nav {
        justify-content: center;
        gap: 12px;
    }

    section {
        margin: 20px 12px;
        padding: 25px 20px;
    }

    .hero {
        padding: 85px 20px;
    }
}
</style>
